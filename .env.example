DATABASE_URL=postgresql://minirag:minirag@127.0.0.1:5433/minirag
EMBEDDING_MODEL=Alibaba-NLP/gte-modernbert-base
OLLAMA_MODEL=qwen3:8b
OLLAMA_HOST=http://127.0.0.1:11434
# Corpus folder to ingest, relative to the repo root. banking or aviation.
CORPUS_DIR=corpora/banking
# Local accounting rates for the three-run scoreboard. They are not cloud prices.
INPUT_USD_PER_MILLION=0.15
OUTPUT_USD_PER_MILLION=0.60
TOOL_USD=0.001

# --- Tier-2 judge provider --------------------------------------------------
# ollama (default, local) or bedrock (AWS). Bedrock also needs JUDGE_MODEL
# set to a Bedrock model id or inference-profile arn, e.g.
#   anthropic.claude-3-5-haiku-20241022-v1:0
# and 'pip install boto3'. Credentials come from the standard AWS chain:
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN / AWS_REGION.
# No key material belongs in this file.
#JUDGE_PROVIDER=bedrock
#JUDGE_MODEL=anthropic.claude-3-5-haiku-20241022-v1:0
#AWS_REGION=us-east-1
